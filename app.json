{
  "expo": {
    "name": "KiddyBank",
    "slug": "KiddyBank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconicy.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "LOCAL_IP": "kiddybank.cs.colman.ac.il",
      "LOCAL_PORT": 3000,
      "router": {},
      "eas": {
        "projectId": "e2b1a56e-e6e5-45b6-a395-631b8b6269f0"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/iconicy.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.KiddyBank"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconicy.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}